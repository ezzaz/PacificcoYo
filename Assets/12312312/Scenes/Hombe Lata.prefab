--- !u!114 &7696950162089383158
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6749694794562941921}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aac5d7864d631284ca512d2c080771ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueMark: {fileID: 7799928256009981625}
  dialoguePanel: {fileID: 0}
  dialogueText: {fileID: 0}
  characterNameText: {fileID: 0}
  rightCharacterImage: {fileID: 0}
  leftCharacterImage: {fileID: 0}
  rightPanel: {fileID: 0}
  leftPanel: {fileID: 0}
  audioSource: {fileID: 2027060921405697513}
  parteAbierto: 0
  esCinematica: 0
  dialogueLines:
  - text: "Disculpe se\xF1or, pero \xBFDe casualidad no sabr\xE1 algo de m\xEDmica?"
    characterName: Chico
    characterImage: {fileID: -7843100869331753995, guid: 99eee8559f9cb044184c44e644e8debe, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 0}
  - text: "\xBFSe\xF1or...?"
    characterName: yo
    characterImage: {fileID: -7431679038244940796, guid: ec43c0674556e064f8ebd168baf48b03, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 0}
  - text: ugh...
    characterName: yo
    characterImage: {fileID: -7431679038244940796, guid: ec43c0674556e064f8ebd168baf48b03, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 0}
  - text: Mimica!? Porque alguien como yo perderia su tiempo enun arte tan soso como
      la mimica!? escuchame chico, ser un hombre de hoj-...
    characterName: Hombre de hojalata
    characterImage: {fileID: 6694444033289656164, guid: c59377b202668b64d800017b772712e6, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 8300000, guid: b081a0d3287da0e48b243cc6e0d0d7fc, type: 3}
  - text: y se nos acabo el tiempo para moverse
    characterName: yo
    characterImage: {fileID: -7431679038244940796, guid: ec43c0674556e064f8ebd168baf48b03, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 0}
  lineIndex: 0
