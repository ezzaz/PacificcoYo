--- !u!114 &3926854085923989547
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8126884601396182926}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aac5d7864d631284ca512d2c080771ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueMark: {fileID: 6984043523524789027}
  dialoguePanel: {fileID: 560771563}
  dialogueText: {fileID: 970129449}
  characterNameText: {fileID: 2139649176}
  rightCharacterImage: {fileID: 1788486695}
  leftCharacterImage: {fileID: 1557686282}
  rightPanel: {fileID: 834516481}
  leftPanel: {fileID: 682321290}
  audioSource: {fileID: 6388440351004511782}
  parteAbierto: 0
  esCinematica: 0
  dialogueLines:
  - text: "Disculpe se\xF1or, pero \xBFDe casualidad no sabr\xE1 algo de m\xEDmica?"
    characterName: Chico
    characterImage: {fileID: -7843100869331753995, guid: 99eee8559f9cb044184c44e644e8debe, type: 3}
    isRightSpeaker: 1
    nextDialogueSound: {fileID: 0}
  - text: "Yo ni idea, pero sabe que la semana pasada me llegaron unos libros, \xFAltima
      edici\xF3n O R I G I N A L"
    characterName: Vendedor Ambulante
    characterImage: {fileID: -5633961650488967263, guid: 8b5b599e13f63964195939096f80cb12, type: 3}
    isRightSpeaker: 1
    nextDialogueSound: {fileID: 0}
  - text: "\xA1MIMICA PARA BOBOS! Este libro en tienda se vende a $50.000, pero por
      ser t\xFA \xA1te lo dejo a solo $5.000! "
    characterName: Vendedor Ambulante
    characterImage: {fileID: -5633961650488967263, guid: 8b5b599e13f63964195939096f80cb12, type: 3}
    isRightSpeaker: 1
    nextDialogueSound: {fileID: 0}
  - text: "\xA1Trato hecho!"
    characterName: Chico
    characterImage: {fileID: -7843100869331753995, guid: 99eee8559f9cb044184c44e644e8debe, type: 3}
    isRightSpeaker: 0
    nextDialogueSound: {fileID: 8300000, guid: b081a0d3287da0e48b243cc6e0d0d7fc, type: 3}
  lineIndex: 0
